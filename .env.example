# Copy this file to .env and add your API tokens
# Get your Genius token from https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=your_genius_access_token_here

# Get your YouTube Data API v3 key from https://console.developers.google.com/
# Enable YouTube Data API v3 in your Google Cloud Console project
YOUTUBE_API_KEY=your_youtube_api_key_here